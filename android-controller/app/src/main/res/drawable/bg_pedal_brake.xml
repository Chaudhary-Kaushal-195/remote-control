<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF2A38"
                android:endColor="#8A1720" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#FF0055" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/pedal_brake_start"
                android:endColor="@color/pedal_brake_end" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FF0055" />
        </shape>
    </item>
</selector>
