<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4A5263"
                android:endColor="#202530" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/pedal_rev_start"
                android:endColor="@color/pedal_rev_end" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#50FFFFFF" />
        </shape>
    </item>
</selector>
