<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1"
        android:text="CONTROLLER SETTINGS"
        android:textColor="@color/accent_primary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="TARGET HARDWARE / MODE"
        android:textColor="@color/gray_text"
        android:textSize="10sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnTargetMode"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_hub_button"
        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="STEERING INPUT"
        android:textColor="@color/gray_text"
        android:textSize="10sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnSteeringMode"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_hub_button"
        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="TRANSMISSION"
        android:textColor="@color/gray_text"
        android:textSize="10sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnTransmission"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_hub_button"
        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

    <LinearLayout
        android:id="@+id/layoutEsp32Config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP32 IP &amp; PORT"
            android:textColor="@color/gray_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEsp32Ip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_hub_button"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="192.168.4.1:4210"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseSettings"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/accent_primary"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.08"
        android:text="BACK TO CONTROLLER"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:cornerRadius="12dp" />

</LinearLayout>
