<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:keepScreenOn="true">

    <!-- ═══════════ COCKPIT GAMEPLAY HUD ═══════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cockpitLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- TOP BAR: Status & Action Hub -->
        <TextView
            android:id="@+id/tvTilt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="Steer: 0°"
            android:textColor="@color/accent_primary"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hub_button"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="STATUS: STANDBY"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@+id/hubButtons"
            app:layout_constraintStart_toEndOf="@+id/tvTilt"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/hubButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnTransmission"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hub_button"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="AUTO"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCamera"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hub_button"
                android:gravity="center"
                android:text="📷"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnPause"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hub_button"
                android:gravity="center"
                android:text="⏸"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_hub_button"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- STEERING WHEEL VIEW -->
        <com.drvice.controller.ui.SteeringWheelView
            android:id="@+id/steeringWheel"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ON-SCREEN BUTTON STEERING (Shown when mode == buttons) -->
        <LinearLayout
            android:id="@+id/buttonSteeringGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.drvice.controller.ui.PedalView
                android:id="@+id/btnSteerLeft"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_hub_button"
                android:gravity="center"
                android:text="⬅️"
                android:textSize="32sp" />

            <com.drvice.controller.ui.PedalView
                android:id="@+id/btnSteerRight"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/bg_hub_button"
                android:gravity="center"
                android:text="➡️"
                android:textSize="32sp" />
        </LinearLayout>

        <!-- PADDLE SHIFTERS (Shown when transmission == manual) -->
        <LinearLayout
            android:id="@+id/gearShiftersGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/steeringWheel">

            <TextView
                android:id="@+id/btnGearUp"
                android:layout_width="95dp"
                android:layout_height="46dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_gear_button"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="SHIFT UP"
                android:textColor="@color/accent_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnGearDown"
                android:layout_width="95dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_gear_button"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="SHIFT DOWN"
                android:textColor="@color/accent_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- MULTI-TOUCH PEDALS -->
        <LinearLayout
            android:id="@+id/pedalGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.drvice.controller.ui.PedalView
                android:id="@+id/pedalReverse"
                android:layout_width="92dp"
                android:layout_height="140dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pedal_rev"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:text="REV"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.drvice.controller.ui.PedalView
                android:id="@+id/pedalBrake"
                android:layout_width="104dp"
                android:layout_height="140dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pedal_brake"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:text="STOP"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <com.drvice.controller.ui.PedalView
                android:id="@+id/pedalGas"
                android:layout_width="114dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_pedal_gas"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:text="GAS"
                android:textColor="@color/white"
                android:textSize="22sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════ NATIVE PAIRING OVERLAY ═══════════ -->
    <FrameLayout
        android:id="@+id/overlayPairing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6080A0F"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12"
                android:text="DR. CONTROL"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="100% PURE NATIVE MOBILE CONTROLLER"
                android:textColor="@color/accent_primary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Method A: Native QR Scan Button -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanQrNative"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/white"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05"
                        android:text="🤳 SCAN QR CODE"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Point camera at laptop screen"
                        android:textColor="@color/gray_text"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="OR"
                    android:textColor="#50FFFFFF"
                    android:textSize="11sp" />

                <!-- Method B: Manual ID Connect -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etHostId"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_hub_button"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:hint="e.g. 10.202.85.130"
                            android:importantForAutofill="no"
                            android:inputType="textNoSuggestions"
                            android:letterSpacing="0.08"
                            android:textColor="@color/white"
                            android:textColorHint="#60FFFFFF"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnectManual"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:backgroundTint="@color/accent_primary"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:text="CONNECT"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Type Laptop IP shown on screen or Scan QR"
                        android:textColor="@color/gray_text"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="💡 TIP: Make sure phone and laptop are on the same Wi-Fi."
                android:textColor="@color/gray_text"
                android:textSize="10sp" />

        </LinearLayout>
    </FrameLayout>

    <!-- ═══════════ NATIVE CAMERAX QR SCANNER OVERLAY ═══════════ -->
    <FrameLayout
        android:id="@+id/scannerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:text="POINT CAMERA AT LAPTOP QR CODE"
                android:textColor="@color/accent_primary"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp">

                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Reticle frame overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_scanner_reticle" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelScanNative"
                android:layout_width="220dp"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/glass_surface"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="CANCEL"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
